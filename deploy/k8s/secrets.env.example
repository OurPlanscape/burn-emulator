# Copy to secrets.env (gitignored) and fill in real values before running:
#   kubectl apply -k deploy/k8s
#
# secrets.env is a plain `KEY=value` env file (no quoting, no export),
# consumed by kustomization.yaml's secretGenerator.

BURN_EMULATOR_JOB_NAMESPACE=burn-emulator-variations
BURN_EMULATOR_ARTIFACT_STORE=gcr.io/planscape/burn-emulator-variations
BURN_EMULATOR_JOB_SERVICE_ACCOUNT=burn-emulator-sa
BURN_EMULATOR_OUTPUT_BUCKET=gs://planscape-burn-emulator
BURN_EMULATOR_TOKEN_AUDIENCE=https://burn-emulator-api.planscape.internal/
BURN_EMULATOR_ALLOWED_CALLERS=caller-a@planscape.iam.gserviceaccount.com,caller-b@planscape.iam.gserviceaccount.com
