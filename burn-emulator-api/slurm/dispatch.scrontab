# scrontab entry for the dispatcher; install as the running user with scrontab -e (replace <...>)
# one pass per minute; scrontab starts the next pass after the previous one finishes
#SCRON --job-name=burn-dispatch
#SCRON --account=<project>
#SCRON --partition=<small>
#SCRON --time=00:05:00
#SCRON --cpus-per-task=1
#SCRON --mem=1G
#SCRON --output=<deploy>/burn-emulator-api/data/logs/dispatch.log
#SCRON --open-mode=append
* * * * * <deploy>/burn-emulator-api/scripts/dispatch.sh
