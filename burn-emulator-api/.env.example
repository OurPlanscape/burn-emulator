# copy to burn-emulator-api/data/.env (gitignored) in the deploy checkout; sourced by scripts/env.sh
# BURN_EMULATOR_ENV and BURN_EMULATOR_OUTPUTS_URI come from $USER's login profile

# runner service account key, mode 600, outside the repo
KEY_FILE=/home/${USER}/.config/burn-emulator/runner-key.json

# shared release dirs (make inputs-release / make model-release); default: this checkout's burn-emulator-model/data/{inputs,bundles}
INPUTS_ROOT=/project/burn-emulator/data/inputs
BUNDLES_ROOT=/project/burn-emulator/data/bundles

# default: burn-emulator-api/data/{gcloud,uv-cache}
# CLOUDSDK_CONFIG=
# UV_CACHE_DIR=

# per-backend sbatch args; empty leaves that backend's claims queued
SLURM_DL_ARGS="--account=<project> --partition=<gpu> --gres=gpu:1"
SLURM_PT_ARGS="--account=<project> --partition=<cpu> --cpus-per-task=32"
INFER_TIME=00:20:00
MAX_INFLIGHT_DL=2
MAX_INFLIGHT_PT=2
